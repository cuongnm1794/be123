{
  "name": "electron-auto-learning",
  "version": "1.0.0",
  "description": "Electron application for automated learning with PostgreSQL and Playwright",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch:main\" \"npm run dev:renderer\" \"npm run dev:electron\" --kill-others-on-fail",
    "dev:renderer": "vite --port 5174",
    "dev:electron": "wait-on http://localhost:5174 dist/main.js && electron .",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "clean": "rimraf dist renderer-dist"
  },
  "keywords": [
    "electron",
    "typescript",
    "postgresql",
    "playwright",
    "automation",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-reloader": "^1.2.3",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^5.0.10",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.3.3",
    "vite": "^5.4.20",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "pg": "^8.11.3",
    "playwright": "^1.40.1"
  }
}
