{
  "name": "be-namcaonguyen",
  "version": "1.0.0",
  "description": "Backend lưu câu hỏi và vị trí đáp án đúng cho extension",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
